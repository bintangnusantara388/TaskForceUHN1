# ==============================================================================
# ERP Kordinasi Task Force Kerjasama Internasional & Reputasi Institusi
# Template Environment Configuration (.env.example)
# ==============================================================================
# Salin berkas ini menjadi .env sebelum menjalankan aplikasi:
# Windows (PowerShell): Copy-Item .env.example .env
# Linux / macOS: cp .env.example .env
# ==============================================================================

# Identitas Aplikasi
APP_NAME="ERP Inventarisasi Reputasi Institusi"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8088
APP_INSTITUTION="Universitas Harkat Negeri"
APP_TASKFORCE="Tim Task Force Kerjasama Internasional & Reputasi Institusi"

# Database Configuration (SQLite)
# Catatan: Basis data SQLite akan dibuat dan di-seed secara otomatis saat pertama kali dibuka jika berkas belum ada.
DB_CONNECTION=sqlite
DB_PATH="database/app.sqlite"

# Media & Berkas Unggahan
UPLOAD_DIR="public/uploads"
MAX_UPLOAD_SIZE=10485760

# Konfigurasi Integrasi AI (Google Gemini API)
# Dapatkan API Key gratis di https://aistudio.google.com/
# Kosongkan ("") jika hanya ingin menggunakan engine lokal bawaan (UHN Neural Synthesizer)
GEMINI_API_KEY=""

# Sesi & Keamanan
SESSION_LIFETIME=7200
