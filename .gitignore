# ==============================================================================
# Git Ignore Configuration - ERP Kordinasi Task Force Kerjasama & Reputasi
# ==============================================================================

# Environment & Secret Configurations
.env
.env.local
.env.*.local
!.env.example

# SQLite Databases & Lock/Journal Files
database/*.sqlite
database/*.sqlite-journal
database/*.sqlite3
database/*.db
*.sqlite
*.sqlite3
*.db

# Uploaded Files & User Media
public/uploads/*
!public/uploads/.gitkeep

# Logs, Cache & Temporary Files
*.log
tests/*.txt
!tests/.gitkeep
tmp/
temp/
.cache/
.phpunit.result.cache

# Dependencies (Composer / NPM)
vendor/
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Flutter / Mobile App Build Artifacts
mobile_app/.dart_tool/
mobile_app/.packages
mobile_app/build/
mobile_app/.flutter-plugins
mobile_app/.flutter-plugins-dependencies

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# IDE & Editor Configurations
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
